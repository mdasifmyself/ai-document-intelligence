# Copy to .env and fill in. Never commit .env.

# --- AI ---------------------------------------------------------------
# "openai": call OpenAI directly with your key (simplest for local runs)
# "n8n":    call an n8n webhook that holds the key (see n8n/README.md) – used by the live demo
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_GATEWAY_URL=
AI_GATEWAY_KEY=
EXTRACTION_MODEL=gpt-4.1-mini
VISION_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
AI_CONCURRENCY=4
AI_DAILY_CALL_LIMIT=3000

# --- Access -------------------------------------------------------------
# Comma-separated access codes. Leave empty only on your own machine.
ACCESS_CODES=
CORS_ORIGINS=http://localhost:3000

# --- Limits -------------------------------------------------------------
MAX_FILE_MB=50
MAX_FILES_PER_UPLOAD=50
MAX_PAGES=1500
OCR_DPI=300

POSTGRES_PASSWORD=docintel
